# Copy this file to a new file named exactly ".env" (no .txt) and fill in the values.
# Windows:  copy .env.example .env        Mac/Linux:  cp .env.example .env
# Never commit .env to GitHub.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (see README, step 2)
MONGODB_URI=

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d

# Frontend address(es) allowed to call this API. Separate several with commas.
CLIENT_URL=http://localhost:3000

# Email (password reset codes and alert emails). Choose ONE of the two options.
# Option A, Resend (works on Render and most hosts; sending to other people needs a verified domain, see README):
RESEND_API_KEY=
MAIL_FROM=StockSense <no-reply@your-domain.com>
# Option B, Gmail SMTP (works on your own computer or a VPS; NOT on Render's free plan, which blocks SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where stock prices come from:
#   live      = real prices from Twelve Data (needs the key below). Use it on your own computer.
#   simulated = the server makes up prices that move like a market, and the app labels them "simulated".
#               Use it on a public site, because free Twelve Data keys may not be shown to other people (see README).
MARKET_DATA_MODE=live
TWELVE_DATA_API_KEY=
# How often to refresh prices while the US market is open (minutes, 5 or more).
QUOTE_REFRESH_MINUTES=30

# Payments (Stripe test mode). Secret key from the Stripe dashboard (starts with sk_test_), and the webhook signing secret
# (starts with whsec_) from "stripe listen" or from your webhook endpoint. See README, "Payments".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: "Continue with Google". The OAuth client ID from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=

# Optional: profile pictures. Three values from your Cloudinary dashboard (see README).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Without a key the AI summary falls back to a rule-based text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Development only: returns the password-reset code in the response (no email service yet)
SHOW_DEV_OTP=true

# Used by "npm run seed" to create the admin account (change these!)
ADMIN_EMAIL=admin@stocksense.dev
ADMIN_PASSWORD=Admin@12345
